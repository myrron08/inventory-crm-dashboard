# Copy to .env and adjust for local dev or VDS production (docker-compose.prod.yml).

# --- Backend (apps/server) ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Frontend build (apps/client) — leave empty for same-origin /api via nginx in Docker ---
VITE_API_URL=
VITE_SOCKET_URL=

# --- Docker production overrides (optional) ---
# CLIENT_ORIGIN=https://your-domain.example
# COMPOSE_CLIENT_PUBLISH=80:80
# With host nginx + Let's Encrypt use: COMPOSE_CLIENT_PUBLISH=127.0.0.1:8080:80
